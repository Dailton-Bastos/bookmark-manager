{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check .",
		"lint:fix": "biome lint . --fix",
		"format:fix": "biome format . --write",
		"check:fix": "biome check . --fix",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"next": "16.2.1",
		"react": "19.2.4",
		"react-dom": "19.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@repo/biome-config": "workspace:*",
		"@repo/tailwind-config": "workspace:*",
		"@repo/testing-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"jsdom": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
