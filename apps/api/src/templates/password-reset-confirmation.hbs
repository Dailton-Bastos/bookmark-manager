{{#> layouts/base }}
	<table
		align="center"
		width="100%"
		border="0"
		cellpadding="0"
		cellspacing="0"
		role="presentation">
		<tbody>
			<tr>
				<td
					style="padding-top:5px;padding-right:20px;padding-left:20px;padding-bottom:10px">
					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						Hi {{ name }},
					</p>
					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						You updated the password for your account. If this was you, then no further action is required.
					</p>

					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						However if you did NOT perform this password change, please
						<a
							href="{{ requestPasswordResetUrl }}"
							style="color:#067df7;text-decoration-line:underline"
							target="_blank"
							rel="noopener noreferrer"
							> reset your account password</a> immediately.
					</p>

					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						Remember to use a password that is both strong and unique to your Bookmark Manager account.
					</p>
					{{> partials/thanks }}
				</td>
			</tr>
		</tbody>
	</table>
{{/layouts/base }}
