{{#> layouts/base }}
	<table
		align="center"
		width="100%"
		border="0"
		cellpadding="0"
		cellspacing="0"
		role="presentation">
		<tbody>
			<tr>
				<td
					style="padding-top:5px;padding-right:20px;padding-left:20px;padding-bottom:10px">
					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						Hi {{ name }},
					</p>
					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						Someone recently requested a password change for your account.
						If this was you, you can set a new password here:
						<a
							href="{{ url }}"
							style="color:#067df7;text-decoration-line:underline"
							target="_blank"
							rel="noopener noreferrer"
							>reset your account password</a
						>
					</p>
					<p
						style="font-size:14px;line-height:1.5;margin-top:16px;margin-bottom:16px">
						If you don't want to change your password or didn't request this, just ignore and delete this message.
					</p>
					{{> partials/thanks }}
				</td>
			</tr>
		</tbody>
	</table>
{{/layouts/base }}
