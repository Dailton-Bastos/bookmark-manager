{
	"name": "api",
	"version": "0.0.1",
	"description": "API for the Bookmark Manager application",
	"author": "Dailton Bastos <dailtonbastos@gmail.com>",
	"private": true,
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "https://github.com/Dailton-Bastos/bookmark-manager"
	},
	"scripts": {
		"build": "nest build",
		"format": "biome format .",
		"start": "nest start",
		"dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "biome lint .",
		"check": "biome check .",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"lint:fix": "biome lint . --fix",
		"format:fix": "biome format . --write",
		"check:fix": "biome check . --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./jest-e2e.config.ts"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/terminus": "^11.1.1",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.20.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@repo/biome-config": "workspace:*",
		"@repo/testing-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@repo/webpack-config": "workspace:*",
		"@swc/jest": "catalog:",
		"@types/express": "^5.0.0",
		"@types/jest": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.2",
		"drizzle-kit": "^0.31.10",
		"globals": "^16.0.0",
		"jest": "catalog:",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"swc-loader": "^0.2.7",
		"ts-jest": "catalog:",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "catalog:"
	}
}
