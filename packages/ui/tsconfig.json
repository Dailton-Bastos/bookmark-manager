{
	"extends": "@repo/typescript-config/nextjs.json",
	"compilerOptions": {
		"outDir": "dist",
		"rootDir": "src",
		"strictNullChecks": true,
		"declaration": false,
		"declarationMap": false,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["dist", "node_modules", "build"]
}
