{
	"name": "ui",
	"version": "1.0.0",
	"description": "UI components for Bookmark Manager",
	"keywords": [
		"ui",
		"components",
		"bookmark manager",
		"tailwind",
		"shadcn"
	],
	"license": "MIT",
	"packageManager": "pnpm@10.30.3",
	"scripts": {
		"lint": "biome lint .",
		"check": "biome check .",
		"lint:fix": "biome lint . --fix",
		"format:fix": "biome format . --write",
		"check:fix": "biome check . --fix"
	},
	"exports": {
		"./globals.css": "./src/globals.css",
		"./lib/*": "./src/lib/*.ts",
		"./components/*": "./src/components/*.tsx",
		"./components/shadcn/*": "./src/components/shadcn/*.tsx",
		"./components/shadcn/ui/*": "./src/components/shadcn/ui/*.tsx"
	},
	"devDependencies": {
		"@repo/biome-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/react": "^19.2.14"
	},
	"dependencies": {
		"@radix-ui/react-slot": "^1.2.4",
		"@repo/tailwind-config": "workspace:*",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.7.0",
		"radix-ui": "^1.4.3",
		"shadcn": "^4.1.1",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0"
	}
}
