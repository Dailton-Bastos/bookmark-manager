{
	"name": "@repo/contract",
	"version": "1.0.0",
	"description": "Contract-first development for the bookmark manager application",
	"keywords": [
		"contract",
		"oRPC",
		"openRPC"
	],
	"license": "MIT",
	"packageManager": "pnpm@10.30.3",
	"main": "dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"dev": "tsc -b --watch",
		"check-types": "tsc --noEmit"
	},
	"dependencies": {
		"@orpc/contract": "^1.13.14",
		"@repo/schemas": "workspace:*",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"typescript": "catalog:"
	}
}
