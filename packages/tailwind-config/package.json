{
	"name": "@repo/tailwind-config",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "Tailwind CSS configuration for the monorepo",
	"keywords": [],
	"license": "ISC",
	"packageManager": "pnpm@10.30.3",
	"exports": {
		".": "./globals.css",
		"./postcss": "./postcss.config.js"
