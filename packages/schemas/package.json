{
	"name": "@repo/schemas",
	"version": "1.0.0",
	"description": "Schemas validation for the bookmark manager application",
	"keywords": [
		"schemas",
		"validation",
		"zod"
	],
	"license": "MIT",
	"packageManager": "pnpm@10.30.3",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"dev": "tsc -b --watch",
		"test": "jest",
		"test:watch": "jest --watch",
		"lint": "biome lint .",
		"check": "biome check .",
		"lint:fix": "biome lint . --fix",
		"format:fix": "biome format . --write",
		"check:fix": "biome check . --fix"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@repo/biome-config": "workspace:*",
		"@repo/testing-config": "workspace:*",
		"@repo/typescript-config": "workspace:*",
		"@types/jest": "catalog:",
		"jest": "catalog:",
		"typescript": "catalog:"
	}
}
